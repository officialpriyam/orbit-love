APP_ENV=development
APP_URL=http://localhost:3000
# Use the same Neon database and Upstash instance as the Next.js app.
DATABASE_URL=
# Optional absolute path for local testing. Default: ../orbit/.local/orbit.db
# SQLITE_PATH=D:/testcodex/orbit/.local/orbit.db
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required in production; generate a random token and store as a deployment secret.
SERVICE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
WORKER_POLL_SECONDS=5
MAX_PARTICIPANTS=3000
# Only the Python service uses OpenRouter. Blank key keeps local explanations.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

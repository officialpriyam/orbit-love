# Copy to .env.local; keep all secrets server-side.
APP_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Empty enables SQLite for local development only.
DATABASE_URL=
SQLITE_PATH=.local/orbit.db
# Neon: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set true after configuring Resend on the separate Python service.
EMAIL_DELIVERY_CONFIGURED=false
# OpenRouter and email provider keys belong ONLY in ../orbit-matching-service/.env.
